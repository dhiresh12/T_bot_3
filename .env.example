# ============================================================
# Xio PayPlus — Environment Variables (copy to .env and fill in)
# ============================================================
# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_BOT_USERNAME=xio_liis_bot

# Admin
ADMIN_KEY=admin-xio-super-secret

# MongoDB (required for production persistence)
# Example: mongodb+srv://user:pass@cluster.mongodb.net/xio_payplus
MONGO_URI=

# Mini App public URL (Render URL after deploy)
# Example: https://xio-payplus.onrender.com
MINI_APP_URL=

# Flask
APP_ENV=production
SECRET_KEY=change-this-to-a-long-random-string
